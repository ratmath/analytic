{
  "name": "@ratmath/analytic",
  "version": "0.1.0",
  "description": "Certified calculus on exact rationals: function values, ranges, integrals, zeros, extrema, limits, Taylor models and validated ODE steps, built on @ratmath/core",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test tests/",
    "docs:build": "bun scripts/build-docs.js"
  },
  "dependencies": {
    "@ratmath/core": "^0.10.0"
  },
  "keywords": [
    "ratmath",
    "taylor-model",
    "interval",
    "validated-numerics",
    "certified",
    "rational"
  ],
  "author": "James Taylor",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/analytic.git"
  },
  "bugs": {
    "url": "https://github.com/ratmath/analytic/issues"
  },
  "homepage": "https://ratmath.com/analytic/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "katex": "0.19.1"
  },
  "types": "index.d.ts"
}
